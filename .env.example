# Marketing harness: environment names (template; copy to .env in the repo root and fill in).
# Rule: names only in chat, memory, plans and reports. A value that reaches chat is burned and rotated.
# The scripts creatives/tools/meta-upload.mjs, meta-graph.mjs and google-ads.mjs read .env in the repo root;
# nothing else in the harness reads this file, and no agent ever opens it (the scripts print names only).
#
# ---------------------------------------------------------------------------------------------------------
# THE CREDENTIAL MAP: every connection the harness has, where its secret lives, and how it is provided.
# Most connections are NOT keys in this file: they log in once through OAuth or their own CLI, and the
# login is stored by Claude Code or by the tool on this computer. Nothing is copied between machines;
# a new company logs in with its own accounts. /health checks each row (the check number is given).
#
#   Connection              Kind                 Where the secret lives                         How it is provided                                  /health
#   meta-ads MCP            OAuth (Meta login)   Claude Code's credential store                 /mcp -> meta-ads -> log in (the Owner's profile)    1, 2
#   fal MCP (optional)      OAuth (fal login)    Claude Code's credential store                 /mcp -> fal -> log in                               8
#   Meta Graph tools        token in THIS file   META_MARKETING_TOKEN below                     /connect: Generate + Copy in the Owner's Chrome on the
#                                                                                               Owner's go, then creatives/tools/env-set.mjs --from-clipboard
#                                                                                               (clipboard -> this line, clipboard cleared; never seen)   13, 20
#   Google Ads tool         OAuth client + login  GOOGLE_ADS_CLIENT_ID / _SECRET and           /connect (only with Google): the client id and secret
#   (only with Google)      in THIS file          GOOGLE_ADS_REFRESH_TOKEN below               copied in the Cloud Console -> env-set.mjs --from-clipboard;
#                                                                                               the login by google-ads.mjs login (the Owner clicks Allow;
#                                                                                               the refresh token goes into this file unseen)             29, 30
#   Vercel CLI (optional)   CLI login            the Vercel CLI's own store in the user folder  npx vercel@latest login                             7
#   HyperFrames (optional)  none                 -                                              -                                                   14
#   Obsidian (optional)     none                 -                                              -                                                   19
#   Claude desktop app      the Claude account   the app's own sign-in (its Code tab runs the   sign in in the app, the Code tab, open this folder  26
#                                                harness with its own copy of Claude Code)
#   Claude in Chrome        the extension's      the extension and the Owner's own Chrome       Chrome Web Store -> Add to Chrome -> sign in with   27
#   (the keys pass)         Claude sign-in       session (facebook.com, the personal profile)   the same Claude account; the app's Connectors
#   Claude Code (terminal)  the Claude account   Claude Code's own login                        claude login (optional; the app carries its own)    -
#
# Optional key lines (commented) for two things the harness does NOT do by default: a script that calls fal
# directly instead of through the fal MCP, and a scheduled Vercel deploy without an interactive login. Nothing
# shipped here reads them; uncomment one only when a tool of your own needs it, and keep the same rule: names only.
#   FAL_KEY=
#   VERCEL_TOKEN=
# ---------------------------------------------------------------------------------------------------------

# The Meta System User token for the two Graph tools: direct image and video uploads to the ad account below
# (meta-upload.mjs; ads_management + ads_read) and the reads and safe writes the MCP has no tool for
# (meta-graph.mjs; the lead subcommands also need leads_retrieval, pages_manage_ads, pages_read_engagement and
# pages_show_list, and the System User needs the Page assigned). Generated in Business Settings -> System users
# (on the Owner's go) and written here by creatives/tools/env-set.mjs --from-clipboard META_MARKETING_TOKEN, which
# clears the clipboard and prints only the character count; never in chat, never pasted by hand unless no clipboard
# tool exists. After a leak: revoke, then env-set.mjs --unset META_MARKETING_TOKEN, then generate again.
# Verify with: node creatives/tools/meta-upload.mjs --check   and   node creatives/tools/meta-graph.mjs check
# Code 200 "API access blocked" on GET /me means the admin's developer account is blocked, not this token.
META_MARKETING_TOKEN=

# Required. The ad account id, digits only, no act_ prefix (the same value as meta_ad_account_id
# in config/accounts.md). Not a secret.
META_AD_ACCOUNT_ID=

# Optional. The Graph API version both scripts call.
META_GRAPH_VERSION=v23.0

# Optional. The Facebook Page id, digits only (the same value as page_id in config/accounts.md). Needed by
# creatives/tools/meta-graph.mjs for lead forms (lead-forms list/create) and used by its leads subcommand to fetch
# the Page token; the System User needs the Page assigned. Not a secret.
META_PAGE_ID=

# ---------- Google Ads (only when Google is one of the platforms in config/operator.md) ----------
# The company's own Google Cloud project owns an OAuth client of type Desktop (Google Auth Platform -> Clients),
# with the Google Ads API enabled and the project's API access level at Explorer or higher (Test reaches test
# accounts only). The id and the secret are copied there and written here by
#   node creatives/tools/env-set.mjs --from-clipboard GOOGLE_ADS_CLIENT_ID   (then the same for GOOGLE_ADS_CLIENT_SECRET)
# The login is node creatives/tools/google-ads.mjs login: the Owner signs in and clicks Allow, and the refresh token
# goes straight into GOOGLE_ADS_REFRESH_TOKEN; nobody sees it. After a leak: remove the app's access in the Google
# account (myaccount.google.com -> Security -> Third-party connections), env-set.mjs --unset GOOGLE_ADS_REFRESH_TOKEN,
# then login again. Verify with: node creatives/tools/google-ads.mjs check
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Required with Google. The Google Ads account, 10 digits, dashes optional (the same value as google_ads_customer_id
# in config/accounts.md; google-ads.mjs refuses to run when they differ). Not a secret.
GOOGLE_ADS_CUSTOMER_ID=

# Optional. The manager account (MCC) the login reaches the account through, 10 digits; empty when the login
# reaches the account directly. Not a secret.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional, legacy. Google sunset developer tokens on 2026-09-09 (access follows the Cloud project now); set it
# only if Google asks for one again. Sent as the developer-token header when set.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional. The Google Ads API version google-ads.mjs calls.
GOOGLE_ADS_API_VERSION=v26
