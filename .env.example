# Marketing harness: environment names (template; copy to .env in the repo root and fill in).
# Rule: names only in chat, memory, plans and reports. A value that reaches chat is burned and rotated.
# The scripts creatives/tools/meta-upload.mjs and creatives/tools/meta-graph.mjs read .env in the repo root.

# The Meta System User token (ads_management + ads_read) for direct image and video uploads
# to the ad account below. Generated only by the Owner in Business Settings -> System users,
# pasted here, never in chat. Verify with: node creatives/tools/meta-upload.mjs --check
# The lead subcommands of meta-graph.mjs also need leads_retrieval, pages_manage_ads, pages_read_engagement
# and pages_show_list on the same token (check with: node creatives/tools/meta-graph.mjs check).
META_MARKETING_TOKEN=

# Required. The ad account id, digits only, no act_ prefix (the same value as meta_ad_account_id
# in config/accounts.md).
META_AD_ACCOUNT_ID=

# Optional. The Graph API version both scripts call.
META_GRAPH_VERSION=v23.0

# Optional. The Facebook Page id, digits only (the same value as page_id in config/accounts.md). Needed by
# creatives/tools/meta-graph.mjs for lead forms (lead-forms list/create) and used by its leads subcommand to fetch
# the Page token; the System User needs the Page assigned. Verify with: node creatives/tools/meta-graph.mjs check
META_PAGE_ID=
