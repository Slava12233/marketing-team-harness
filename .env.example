# Marketing harness: environment names (template; copy to .env in the repo root and fill in).
# Rule: names only in chat, memory, plans and reports. A value that reaches chat is burned and rotated.
# The script creatives/tools/meta-upload.mjs reads .env in the repo root.

# The Meta System User token (ads_management + ads_read) for direct image and video uploads
# to the ad account below. Generated only by the Owner in Business Settings -> System users,
# pasted here, never in chat. Verify with: node creatives/tools/meta-upload.mjs --check
META_MARKETING_TOKEN=

# Required. The ad account id, digits only, no act_ prefix (the same value as meta_ad_account_id
# in config/accounts.md).
META_AD_ACCOUNT_ID=

# Optional. The Graph API version the upload script calls.
META_GRAPH_VERSION=v23.0
