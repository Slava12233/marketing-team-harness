# Secrets
.env
.env.*
!.env.example
.env.local

# Every copy is a new business (memory/tools/instance.mjs): the instance marker names this folder and computer,
# and a previous company's files are archived beside it; neither is ever committed
.harness-instance.json
.previous-company/

# Upload ledgers (ids and hashes of a real account)
creatives/uploads/*.json

# Media and build output
creatives/**/media/*
!creatives/**/media/.gitkeep
node_modules/
*.log

# Local control-room state
dashboard/state.local.json

# Generated per company: the setup wizard's data (dashboard/setup-page.mjs) and live install file (the bootstrap);
# the wizard page itself (setup.html, setup-wizard.js, setup-default.js) ships with the harness
dashboard/setup-data.js
dashboard/setup-live.js
dashboard/setup-live.js.tmp
dashboard/setup-progress.json
dashboard/bootstrap-result.json
dashboard/*.tmp

# Release zips built by release.sh / release.ps1
dist/

# Media: the vault and the repo track text; pictures, videos, fonts and PDFs under creatives/ and reports/ stay on disk only
creatives/**/*.png
creatives/**/*.jpg
creatives/**/*.jpeg
creatives/**/*.gif
creatives/**/*.webp
creatives/**/*.mp4
creatives/**/*.mov
creatives/**/*.webm
creatives/**/*.mp3
creatives/**/*.wav
creatives/**/*.woff
creatives/**/*.woff2
creatives/**/*.ttf
creatives/**/*.otf
creatives/**/*.pdf
reports/**/*.png
reports/**/*.jpg
reports/**/*.pdf
reports/**/*.mp4

# Tooling and local state
.vercel/
.vscode/
*.tmp

# Obsidian: per-machine workspace and caches stay local; app.json, core-plugins.json, appearance.json, bookmarks.json and templates.json are tracked
.obsidian/workspace*.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.trash/

# The account guard's record of object ids a Meta read or create returned (ids only; rebuilt by use)
memory/state/known-objects.json
# Codex only: the go ticket the main session writes in the turn of the Owner's go (account-guard.mjs --ticket)
memory/state/go-ticket.json

# Backups written by upgrade.sh / upgrade.ps1 before a file is replaced
.upgrade-backup/

# CSV exports of meta-graph.mjs insights (campaign names and figures, kept on this machine)
reports/data/
# Rendered client reports (report-render.mjs); the Markdown is the source
reports/**/*.html
