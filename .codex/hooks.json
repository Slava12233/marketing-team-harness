{
  "description": "Generated by memory/tools/codex-sync.mjs; never hand-edit: change .claude/settings.json and run node memory/tools/codex-sync.mjs --write",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs --codex",
            "commandWindows": "node .claude/hooks/session-start.mjs --codex",
            "timeout": 15,
            "additionalContextLimit": 200000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-compact.mjs --codex",
            "commandWindows": "node .claude/hooks/pre-compact.mjs --codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs --codex",
            "commandWindows": "node .claude/hooks/session-start.mjs --codex",
            "timeout": 15,
            "additionalContextLimit": 200000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__meta-ads__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/account-guard.mjs --codex",
            "commandWindows": "node .claude/hooks/account-guard.mjs --codex",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__meta-ads__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/account-guard.mjs --codex",
            "commandWindows": "node .claude/hooks/account-guard.mjs --codex",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
